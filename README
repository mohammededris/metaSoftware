│       ├── user.js
│       └── validate.js
├── Models/
│   ├── Post.js
│   └── User.js
├── Routes/
│   ├── posts.js
│   └── users.js
├── .env
├── index.js
├── package.json
├── README.md
```

## 7. Notes

- Passwords are hashed using `bcrypt` before being stored.
- JWT tokens are used for authenticated access to post routes.
- Incoming payloads are validated using `Joi` before processing.

